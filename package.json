{
  "name": "rest-in-tabs",
  "version": "0.1.1",
  "private": true,
  "description": "Chrome/Edge extension that buries idle tabs in a spooky graveyard and lets you resurrect them in one click.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "zip": "npm run build && node scripts/zip-dist.mjs",
    "icons": "node scripts/render-icons.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
